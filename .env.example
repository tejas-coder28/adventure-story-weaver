# Environment settings for Adventure Story Weaver
# Note: The model runs 100% locally with PyTorch and requires no external API keys or paid services.

# Optional path overrides
CORPUS_PATH=data/corpus.txt
TOKENIZER_PATH=artifacts/tokenizer.json
